# =============================================================================
# 服务器部署环境变量模板（与本机 .env 分开）
# =============================================================================
#
# 本机：继续用现有 .env + docker-compose.dev.yml，不要覆盖。
# 服务器：
#   1) cp .env.example .env
#   2) 对照本文件，把下面「必改 / 建议」项写进服务器上的 .env
#   3) docker compose -f docker-compose.yml -f docker-compose.server.yml up -d
#
# 完整变量说明见 .env.example；本文件只列与本地差异大、或生产必须改的项。
# =============================================================================

# ---------- 运行模式 ----------
GIN_MODE=release
LOG_LEVEL=info
# LLM_DEBUG_LOG=false

# 生产建议关闭公开注册
DISABLE_REGISTRATION=true

# ---------- 对外访问（按实际域名/IP 改）----------
# 前端端口（宿主机）
FRONTEND_PORT=80
# App 宿主机映射端口
APP_PORT=8080
# IM / 外链图片等需要公网可达地址时填写，例如 https://weknora.example.com
# APP_EXTERNAL_URL=https://weknora.example.com

# ---------- Docker 网络内服务名（全栈 compose 必用，勿写成 localhost）----------
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
# 生产务必改成强密码
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=WeKnora

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_ADDR=redis:6379

DOCREADER_ADDR=docreader:50051
DOCREADER_TRANSPORT=grpc

# 向量库：默认 postgres；若启用 --profile qdrant / milvus，再改 RETRIEVE_DRIVER 并打开对应段
RETRIEVE_DRIVER=postgres
# QDRANT_HOST=qdrant
# QDRANT_PORT=6334
# MILVUS_ADDRESS=milvus:19530

# ---------- 文件存储 ----------
# local：文件在 data-files volume → 宿主机 /data/weknora/files
# minio：需 --profile minio，数据在 /data/weknora/minio
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files

# 若用 MinIO：
# STORAGE_TYPE=minio
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY_ID=CHANGE_ME_MINIO_ACCESS
# MINIO_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_SECRET
# MINIO_BUCKET_NAME=weknora
# 对外（IM/浏览器）访问 MinIO 时，MINIO_ENDPOINT 需是客户端可达地址，见 .env.example 说明

# ---------- 密钥（生产必须重新生成，勿用示例值）----------
# JWT_SECRET=$(openssl rand -base64 32)
JWT_SECRET=CHANGE_ME_JWT_SECRET
# SYSTEM_AES_KEY 必须恰好 32 字节
SYSTEM_AES_KEY=CHANGE_ME_32_BYTE_AES_KEY_HERE!
TENANT_AES_KEY=CHANGE_ME_TENANT_AES_KEY

# ---------- 可选组件（默认关闭，按需启用 profile）----------
ENABLE_GRAPH_RAG=false
NEO4J_ENABLE=false
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD

OIDC_AUTH_ENABLE=false

# Ollama 若装在宿主机：容器内访问宿主机用 host.docker.internal（Linux 需 compose 已配 extra_hosts）
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------- Langfuse（可选 --profile langfuse）----------
# LANGFUSE_HOST=http://langfuse-web:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_ENVIRONMENT=production
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_NEXTAUTH_URL=https://langfuse.example.com

# ---------- 磁盘说明（配合 docker-compose.server.yml）----------
# 固态（约 100G+）：系统、Docker 镜像、Postgres（含向量检索，保证查询性能）
# 机械盘 /data：原文件、MinIO、可选 Qdrant/Milvus/Neo4j/Langfuse 等大体积数据
# 宿主机目录示例：/data/weknora/{files,minio,...}
# 容器内 LOCAL_STORAGE_BASE_DIR 仍是 /data/files，由 volume data-files 映射，无需改成宿主机路径。
